<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS config: adds UDP on the robot's WiFi interface for
     cross-machine discovery (Docker on dev machine), while preserving
     built-in transports (SHM + UDP on lo) for local tools. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>UDP</transport_id>
                <type>UDPv4</type>
                <interfaceWhiteList>
                    <address>192.168.43.101</address>
                </interfaceWhiteList>
            </transport_descriptor>
        </transport_descriptors>
    </profiles>
</dds>
