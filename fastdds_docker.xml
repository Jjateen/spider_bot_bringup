<?xml version="1.0" encoding="UTF-8"?>
<!-- Fast DDS config for the dev-machine Docker container.
     No interface filter — just uses default UDP transport to discover
     the robot on the subnet. Set FASTRTPS_DEFAULT_PROFILES_FILE to this
     and ROS_AUTOMATIC_DISCOVERY_RANGE=SUBNET. -->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>UDP</transport_id>
                <type>UDPv4</type>
            </transport_descriptor>
        </transport_descriptors>
    </profiles>
</dds>
