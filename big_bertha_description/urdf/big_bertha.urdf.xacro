  <!-- IMU frame (MPU6050 on the body; hardware BOM name). No mesh.
       Identity rotation vs base_link, matching training's ImuCfg
       convention (not the MPU_9265 mesh's own cosmetic mount rotation). -->
  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-06" iyy="1e-06" izz="1e-06" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.012 0.016 0.003"/></geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

