<?xml version="1.0" ?>
<!--
  Big Bertha quadruped description (ROS 2 Jazzy + Gazebo Harmonic).

  Migrated from training's source CAD export:
    spider_bot_training/assets/URDF/big_bertha/Spyder_mg995_description.urdf
  (the file the policy actually trained against).
  Base geometry, joint origins, mesh visuals/collisions and raw inertials
  are verbatim from that file; only the following bringup additions are made:
    - xacro args + mesh_pkg property (package:// URIs, not ./meshes/)
    - ydlidar_link/ydlidar_joint renamed lidar_link/lidar_joint (bringup convention)
    - imu_link + imu_joint (identity vs base_link, training ImuCfg convention)
    - joint effort/velocity limits + dynamics (non-binding 1000, damping 0.02)
    - modular includes: big_bertha.gazebo.xacro, big_bertha.ros2_control.xacro
-->
<robot name="big_bertha" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================= XACRO Arguments ======================== -->
  <xacro:arg name="use_gz" default="true"/>
  <xacro:arg name="publish_odom" default="true"/>
  <xacro:arg name="odom_tf" default="true"/>
  <xacro:arg name="sim_drive" default="false"/>
  <xacro:arg name="ros2_control_config" default="$(find big_bertha_description)/config/ros2_control.yaml"/>

  <xacro:property name="mesh_pkg" value="package://big_bertha_description/meshes"/>

  <!-- ============================ Materials ============================ -->
  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.200 0.200 0.200 1.000"/>
  </material>


