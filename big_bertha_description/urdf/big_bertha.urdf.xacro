  <link name="arm_c_4_1">
    <inertial>
      <origin xyz="-0.00152686 -0.01416578 -0.02679160" rpy="0 0 0"/>
      <mass value="0.063683"/>
      <!-- ARMATURE EMULATION (not the raw CAD inertia). The CAD calf inertia
           is ~3.4e-5; we add +0.005 to model Isaac's per-joint `armature`
           (reflected servo rotor inertia), which training pins at 0.005 in
           clean eval and whose own note says "zero armature makes the explicit
           PD unstable". gz-sim 8 / sdformat14 has no <armature> joint element,
           so it is folded into the link inertia here. Added ISOTROPICALLY (all
           three diagonals, not izz-only) to keep the tensor a valid rigid body
           (izz-only violates ixx+iyy>=izz and NaNs DART); the joint-axis (z)
           term is what matters. Without this the light calf resonates to ~19
           rad/s (feet skitter, no push-off, 0.029 m/s); with it the ankle
           stays under the 6.54 cap and straight-walk tracks 1:1 (0.125 m/s at
           0.12 cmd, matching Isaac's 0.97 ratio). -->
      <inertia ixx="0.00503860" ixy="-0.00000290" ixz="-0.00000068" iyy="0.00501100" iyz="-0.00000123" izz="0.00503402"/>
    </inertial>
    <visual>
      <origin xyz="0.01 -0.145 -0.053" rpy="1.57 0 -3.14"/>
      <geometry>
        <mesh filename="${mesh_pkg}/arm_c_right.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <visual>
      <origin xyz="0 -0.01 -0.045" rpy="0 0 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/servo_mg995.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <!-- Foot contact: a sphere at the toe tip, not the STL mesh. DART does
         literal mesh-plane contact (points jump between triangles -> noisy,
         non-deterministic footing -> the gait wanders); a sphere gives one
         clean, stable contact point. PhysX convex-decomposes so Isaac is
         fine with the mesh. Visual keeps the mesh. Offset is training's own
         FK tip_offset (big_bertha_env.py: self._tip_offset), the same
         constant training uses to map the arm_c link pose to the actual
         foot-tip contact point for its own slip metric. -->
    <collision name="arm_c_4_1_foot">
      <origin xyz="0.01 -0.145 -0.053" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
  </link>

