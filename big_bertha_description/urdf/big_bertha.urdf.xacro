  <!-- YDLidar X2. Position derived from training's real mounting chain
       (base_link to battery_link to circuit_box_base_link, both fixed
       joints), not the old bringup-specific "+4cm ghost-wall workaround"
       height, which was tuned against a stale URDF. -->
  <link name="lidar_link">
    <inertial>
      <origin xyz="0 0 0.08" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia ixx="7.980e-05" iyy="7.980e-05" izz="9.710e-05" ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
    <visual>
      <origin xyz="0.055 0.005 0.06" rpy="0 0 3.14"/>
      <geometry>
        <mesh filename="${mesh_pkg}/ydlidar.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.055 0.005 0.06" rpy="0 0 3.14"/>
      <geometry>
        <mesh filename="${mesh_pkg}/ydlidar.stl" scale="0.0001 0.0001 0.0001"/>
      </geometry>
    </collision>
  </link>

  <!-- Bigger/heavier battery per the 2026-08-28 hardware CAD refresh
