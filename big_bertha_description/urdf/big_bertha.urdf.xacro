  <!-- ============================== Joints ============================= -->
  <!-- Joint origins/axes/limits copied verbatim from training's finalized
       URDF (Spyder_mg995_description_v2.urdf), the file big_bertha_v1.0.0
       actually trained against: hip +-1.57 rad, thigh -1.57/0.96 rad, calf
       0/2.355 rad. effort/velocity are left non-binding (1000): the real
       MG995 servo specs (1.18 N*m, 6.54 rad/s) are enforced as a soft
       torque-based actuator saturation in JointEffortPdController (matching
       Isaac's IdealPDActuatorCfg), not as a hard URDF/DART kinematic
       constraint, the latter caused the calf joints to pin at the
       hardware cap every tick under the old (bringup-specific) geometry. -->
  <!-- Leg 4 (back-left): Revolute_110/111/112 -->
  <joint name="Revolute_110" type="revolute">
    <origin xyz="0.06410394 0.07999993 0.04" rpy="1.570796 -0 -0.785"/>
    <parent link="base_link"/>
    <child link="arm_a_4_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_111" type="revolute">
    <origin xyz="0 -0.008 -0.052" rpy="0 1.57 1.57"/>
    <parent link="arm_a_4_1"/>
    <child link="arm_b_4_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="0.96" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_112" type="revolute">
    <origin xyz="0.08 0.03 0" rpy="0 1.57 1.57"/>
    <parent link="arm_b_4_1"/>
    <child link="arm_c_4_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.355" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- Leg 1 (front-left): Revolute_113/114/115 -->
  <joint name="Revolute_113" type="revolute">
    <origin xyz="-0.07989606 0.06299993 0.04" rpy="1.570796 -0 0.785"/>
    <parent link="base_link"/>
    <child link="arm_a_1_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_114" type="revolute">
    <origin xyz="0 -0.008 -0.052" rpy="0 1.57 1.57"/>
    <parent link="arm_a_1_1"/>
    <child link="arm_b_1_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="0.96" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_115" type="revolute">
    <origin xyz="0.08 0.03 0" rpy="0 1.57 1.57"/>
    <parent link="arm_b_1_1"/>
    <child link="arm_c_1_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.355" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- Leg 2 (front-right): Revolute_116/117/118 -->
  <joint name="Revolute_116" type="revolute">
    <origin xyz="-0.06219606 -0.08000007 0.04" rpy="1.570796 -0 2.355"/>
    <parent link="base_link"/>
    <child link="arm_a_2_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_117" type="revolute">
    <origin xyz="0 -0.008 -0.052" rpy="0 1.57 1.57"/>
    <parent link="arm_a_2_1"/>
    <child link="arm_b_2_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="0.96" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_118" type="revolute">
    <origin xyz="0.08 0.03 0" rpy="0 1.57 1.57"/>
    <parent link="arm_b_2_1"/>
    <child link="arm_c_2_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.355" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- Leg 3 (back-right): Revolute_119/120/121 -->
  <joint name="Revolute_119" type="revolute">
    <origin xyz="0.08010394 -0.06300007 0.04" rpy="1.570796 -0 -2.355"/>
    <parent link="base_link"/>
    <child link="arm_a_3_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="1.57" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_120" type="revolute">
    <origin xyz="0 -0.008 -0.052" rpy="0 1.57 1.57"/>
    <parent link="arm_a_3_1"/>
    <child link="arm_b_3_1"/>
    <axis xyz="0 1.0 0"/>
    <limit lower="-1.57" upper="0.96" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <joint name="Revolute_121" type="revolute">
    <origin xyz="0.0775 0.03 0.001" rpy="0 1.57 1.57"/>
    <parent link="arm_b_3_1"/>
    <child link="arm_c_3_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="0" upper="2.355" effort="1000.0" velocity="1000.0"/>
    <dynamics damping="0.02" friction="0.0"/>
  </joint>

  <!-- Fixed sensor / payload frames. Chain and origins copied verbatim from
       training's mounting hierarchy (base_link -> battery_link ->
       circuit_box_base_link -> circuit_box_link -> lidar_link, all fixed
       joints), not bringup's old hand-tuned values (which had a different
       lidar height/position, a "+4cm ghost-wall workaround" tuned against a
       stale URDF). -->
  <joint name="battery_joint" type="fixed">
    <origin xyz="0.00080394 -0.00070007 0.0585" rpy="3.140796 -0 0"/>
    <parent link="base_link"/>
    <child link="battery_link"/>
  </joint>

  <joint name="circuit_box_base_joint" type="fixed">
    <!-- z was -0.0029; the taller 2026-08-28 battery pushed this mount
         point down to -0.0245. -->
    <origin xyz="0 0 -0.0245" rpy="0 3.14 0"/>
    <parent link="battery_link"/>
    <child link="circuit_box_base_link"/>
  </joint>

  <joint name="circuit_box_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="circuit_box_base_link"/>
    <child link="circuit_box_link"/>
  </joint>

  <!-- ydlidar_joint in training's URDF; renamed lidar_link/lidar_joint to
       match bringup's existing sensor-plugin references (gazebo.xacro,
       ros2_control), naming only, the mount point is training's own.

       +0.02 m local offset added 2026-09-02: raises the physical lidar
       mount height per scan_ground_filter.cpp's own documented lever
       ("raise the lidar or reduce gait tilt"). Deliberately NOT the old
       "+4cm ghost-wall workaround" this file's header already warns about
       reintroducing, since that value was tuned against a since-replaced
       mount chain and isn't evidence for this one. This offset is on
       lidar_joint only, not the battery/circuit_box chain above it, so it
       doesn't touch any training-matched mass/inertia geometry: the
       trained policy consumes joint state/IMU/cmd_vel, not lidar data, so
       the sensor's own mount height has no bearing on matching training
       dynamics. Sign is in circuit_box_link's local frame (rotated about
       180 deg through the mount chain from base_link); verify the
       resulting lidar-height-above-base_link (scan_ground_filter's own
       startup log line: "mount resolved: lidar X m above base_link")
       actually increased, not decreased, before trusting this value. -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <parent link="circuit_box_link"/>
    <child link="lidar_link"/>
  </joint>

  <!-- IMU stays a direct base_link child (not chained through circuit_box)
       so its rotation is identity vs base_link, matching training's own
       ImuCfg convention (rot=(1,0,0,0)) rather than the MPU_9265 mesh's own
       cosmetic mount rotation inside circuit_box_link. XY matches
       battery_joint (both sit on the same central stack); Z is higher
       since the IMU sits above the battery. -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.00080394 -0.00070007 0.0614" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- =================== ros2_control + Gazebo plugins ================= -->
  <xacro:if value="${use_gz}">
    <xacro:include filename="$(find big_bertha_description)/urdf/big_bertha.ros2_control.xacro"/>
    <xacro:include filename="$(find big_bertha_description)/urdf/big_bertha.gazebo.xacro"/>
  </xacro:if>

</robot>
