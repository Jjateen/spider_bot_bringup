  <link name="arm_c_2_1">
    <inertial>
      <!-- Symmetrized with arm_c_3_1 2026-08-28: both links are the same
           physical part (arm_c_left.stl, same as arm_a_1_1/arm_c_1_1's
           "right" pair is already byte-identical), there is no legitimate
           hardware reason for them to differ. The CAD export gave them
           different numbers (iyy differed ~50%, CoM ~22mm apart), matching
           a transcription-artifact pattern already diagnosed once before on
           a different branch (see [[project_sim2sim_walking_regression]]
           in memory) as a cause of heading drift, confirmed by A/B test
           here too (symmetrizing cut an 8s straight-walk yaw veer from
           +0.043 rad to +0.015 rad). No independent reference (training's
           own URDF) was available to pick one measurement as correct, so
           these are the arithmetic mean of the two CAD readings. -->
      <origin xyz="0.00010937 -0.01746521 -0.03616019" rpy="0 0 0"/>
      <mass value="0.063683"/>
      <!-- ARMATURE EMULATION: see arm_c_1_1 for the full rationale. CAD calf
           inertia ~3.4e-5; +0.005 isotropic emulates Isaac's `armature` (no
           native <armature> in gz-sim 8). Restores 1:1 straight-walk. -->
      <inertia ixx="0.00503677" ixy="-0.00000253" ixz="0.00000127" iyy="0.00501292" iyz="0.00000189" izz="0.00503492"/>
    </inertial>
    <visual>
