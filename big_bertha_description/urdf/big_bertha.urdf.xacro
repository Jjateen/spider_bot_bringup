  <joint name="Revolute_113" type="revolute">
    <origin xyz="-0.07989606 0.06299993 0.04" rpy="1.570796 -0 0.785" />
    <parent link="base_link" />
    <child link="arm_a_1_1" />
    <axis xyz="0 1.0 0" />
    <limit effort="1000.0" velocity="1000.0" lower="-1.57" upper="1.57" />
    <!-- damping 0.25, not 0.02: measured against an Isaac reference run of
         the same policy and command. Isaac holds ankle amplitude at
         0.47-0.50 rad; at 0.02 Gazebo overshot to 0.79, so the foot
         arrived fast and skidded. 0.25 brings it to 0.49/0.46/0.38/0.58,
         lifts forward tracking 28% -> 35% of command, and drops body
         pitch 9.3 -> 7.9 deg against Isaac's 8.0 deg tilt p95. -->
    <dynamics damping="0.25" friction="0.0"/>
  </joint>
