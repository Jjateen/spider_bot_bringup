         0.47-0.50 rad; at 0.02 Gazebo overshot to 0.79, so the foot
         arrived fast and skidded. 0.25 brings it to 0.49/0.46/0.38/0.58,
         lifts forward tracking 28% -> 35% of command, and drops body
         pitch 9.3 -> 7.9 deg against Isaac's 8.0 deg tilt p95. -->
    <dynamics damping="0.25" friction="0.0"/>
  </joint>
  <joint name="Revolute_121" type="revolute">
    <origin xyz="0.0775 0.03 0.001" rpy="0 1.57 1.57" />
    <parent link="arm_b_3_1" />
    <child link="arm_c_3_1" />
    <axis xyz="0 0 1" />
    <limit effort="1000.0" velocity="1000.0" lower="0" upper="2.355" />
    <!-- damping 0.25, not 0.02: measured against an Isaac reference run of
         the same policy and command. Isaac holds ankle amplitude at
         0.47-0.50 rad; at 0.02 Gazebo overshot to 0.79, so the foot
         arrived fast and skidded. 0.25 brings it to 0.49/0.46/0.38/0.58,
         lifts forward tracking 28% -> 35% of command, and drops body
         pitch 9.3 -> 7.9 deg against Isaac's 8.0 deg tilt p95. -->
    <dynamics damping="0.25" friction="0.0"/>
  </joint>
  <joint name="battery_joint" type="fixed">
    <origin xyz="0.00080394 -0.00070007 0.0585" rpy="3.140796 -0 0" />
    <parent link="base_link" />
    <child link="battery_link" />
  </joint>
  <joint name="circuit_box_base_joint" type="fixed">
    <origin xyz="0 0 -0.0245" rpy="0 3.14 0" />
    <parent link="battery_link" />
    <child link="circuit_box_base_link" />
  </joint>
  <joint name="circuit_box_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="circuit_box_base_link" />
    <child link="circuit_box_link" />
  </joint>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="circuit_box_link" />
    <child link="lidar_link" />
  </joint>
  <!-- IMU frame (MPU6050 on the body; identity vs base_link, training ImuCfg rot=(1,0,0,0)) -->
  <link name="imu_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-06" ixy="0" ixz="0" iyy="1e-06" iyz="0" izz="1e-06"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.012 0.016 0.003"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.0657 -0.0657 0.0614"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>


  <!-- ======================== Modular XACROs ========================== -->
  <xacro:include filename="$(find big_bertha_description)/urdf/big_bertha.gazebo.xacro"/>
  <xacro:include filename="$(find big_bertha_description)/urdf/big_bertha.ros2_control.xacro"/>

  <xacro:if value="$(arg use_gz)">
    <xacro:big_bertha_gazebo
      publish_odom="$(arg publish_odom)"
      odom_tf="$(arg odom_tf)"
      sim_drive="$(arg sim_drive)"/>
    <xacro:big_bertha_ros2_control
      ros2_control_config="$(arg ros2_control_config)"/>
  </xacro:if>

</robot>
