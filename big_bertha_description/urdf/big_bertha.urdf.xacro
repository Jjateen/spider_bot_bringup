<?xml version="1.0" ?>
<!--
  Big Bertha quadruped description (ROS 2 Jazzy + Gazebo Harmonic).

  Link/joint geometry, meshes, and inertials are ported directly from
  training's finalized source CAD export
  (assets/URDF/big_bertha/Spyder_mg995_description_v2.urdf), the file the
  big_bertha_v1.0.0 policy actually trained against, not patched onto the
  older bringup-specific geometry (which had its own joint origins and a
  hand-tuned lidar height/position from an earlier, now-superseded URDF).

  Refreshed 2026-08-28 against a newer hardware-revision CAD export
  (big_bertha_description/urdf/Spyder_mg995_description.urdf, no _v2 suffix,
  a raw, non-xacro URDF dump, base_link-relative coordinates only, no
  ros2_control/gazebo scaffolding). base_link now uses that export's raw CAD
  origin directly, verified as the true geometric center of the chassis: the
  4 leg-mount points on both the bottom and top perforated plates average to
  (0,0) in this frame to within 1e-4 m. An earlier pass at this transfer
  preserved an inherited offset from the older xacro (+0.06489606,
  -0.06499993 relative to this frame) under the mistaken assumption that
  matching nav2_params.yaml's already-tuned footprint polygon meant that
  offset was the correct/centered choice, it wasn't actually centered, it
  was just wherever one CAD sub-part's own local mesh origin happened to
  land. Corrected: base_link, the 4 hip joints, battery_joint, and imu_joint
  (a bringup-synthetic frame with no CAD source of its own, but still
  base_link-relative so it moves too) all use the raw/true-centered frame
  now; nav2_params.yaml's footprint polygon has been re-derived into this
  frame to match (see that file's own note). The actual hardware delta the
  new export carries is real: a bigger/heavier battery (0.18kg
  0.107x0.035x0.025m to 0.5kg 0.1083x0.07745x0.047m), which pushed
  circuit_box_base_joint's mount point down accordingly, plus small
  CAD-refinement updates to circuit_box_link's inertia and the MPU_9265
  chip's mesh placement. Joint topology (names, parent/child, axes, limits)
  is unchanged, so ros2_control.yaml's joint list and ordering remain valid
  untouched.

  arm_c_2_1/arm_c_3_1 (2026-08-28, later same day): the CAD export gave
  these two links different inertia despite both using arm_c_left.stl,
  the same physical part as each other, mounted at different corners. That
  has no legitimate hardware explanation and matched a transcription-
  artifact pattern already diagnosed once before on a different branch
  (see memory: project_sim2sim_walking_regression), confirmed here too by
  an A/B test (symmetrizing cut an 8s straight-walk yaw veer from +0.043
  rad to +0.015 rad). Re-symmetrized to the arithmetic mean of the two CAD
  readings (no independent/training reference was available to pick one
  as correct), see each link's own inertial comment.

  Augmented with:
    - a gz_ros2_control system plugin,
    - a 12-joint position ros2_control block,
    - a gz 2D lidar sensor on lidar_link (YDLidar X2),
    - a gz IMU sensor on imu_link (MPU6050, identity rotation vs base_link,
      matching training's ImuCfg convention),
    - gz friction/material surface properties.

  Joints Revolute_110 .. Revolute_121 (4 legs x 3 joints) are position
  controlled by gz_ros2_control. Default per-leg pose (big_bertha_v1.0.0
  pin-tip pose) is [0.0, -0.32, 2.00], hip, thigh, calf.
-->
<robot name="big_bertha" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================ Arguments ============================ -->
  <!-- Use ros2_control + gz sensors when running in Gazebo; disable for a
       pure visualisation / check_urdf pass. -->
  <xacro:arg name="use_gz" default="true"/>
  <!-- ros2_control.yaml passed to the gz_ros2_control plugin. -->
  <xacro:arg name="ros2_control_config"
             default="$(find big_bertha_description)/config/ros2_control.yaml"/>
  <!-- Forwarded to the gz OdometryPublisher in big_bertha.gazebo.xacro. -->
  <xacro:arg name="publish_odom" default="true"/>
  <!-- When false, the EKF (state_estimation) owns the odom->base_link tf. -->
  <xacro:arg name="odom_tf" default="true"/>
  <!-- Sim-only kinematic drive (gz VelocityControl) for verification gates. -->
  <xacro:arg name="sim_drive" default="false"/>

  <xacro:property name="use_gz" value="$(arg use_gz)"/>

  <!-- ============================ Materials ============================ -->
  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.200 0.200 0.200 1.000"/>
  </material>

  <!-- ======================= Convenience macros ======================= -->
  <xacro:property name="mesh_pkg" value="package://big_bertha_description/meshes"/>

  <!-- ============================== Links ============================== -->
  <!-- base_link origin is the raw CAD origin from Spyder_mg995_description.urdf
       (the 2026-08-28 hardware CAD refresh), verified as the true geometric
       center of the chassis: the 4 leg-mount points on both the bottom and
       top perforated plates average to (0,0) in this frame to within 1e-4 m.
       An earlier pass at this transfer preserved an inherited offset from
       the older xacro (+0.06489606, -0.06499993 relative to this frame)
       under the mistaken assumption that "already matches nav2's footprint
       tuning" meant "correct/centered", it wasn't actually centered, it
       was just wherever one CAD sub-part's own local mesh origin happened to
       land. Corrected here; nav2_params.yaml's footprint polygon has been
       re-derived into this frame to match (see that file). -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.02039469" rpy="0 0 0"/>
      <mass value="0.263885"/>
      <inertia ixx="0.00116595" ixy="-0.00000226" ixz="0.00000001" iyy="0.00116867" iyz="0.00000004" izz="0.00226074"/>
    </inertial>
    <visual>
      <origin xyz="-0.06489606 0.06499993 0.005" rpy="3.140796 -0 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/central_perforated_plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="-0.06489606 0.06499993 0.005" rpy="3.140796 -0 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/central_perforated_plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="-0.06489606 0.06499993 0.035" rpy="3.140796 -0 0"/>
      <geometry>
        <mesh filename="${mesh_pkg}/central_perforated_plate.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
