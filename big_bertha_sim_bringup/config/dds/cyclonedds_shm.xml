<?xml version="1.0" encoding="UTF-8" ?>
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain id="any">
    <!-- Used by gz_server and policy_controller_node only (per-process scoping
         in simulation.launch.py), not domain-wide. SharedMemory Enable is a
         per-PARTICIPANT setting, not per-topic, and a blanket Enable=true for
         the whole graph hangs spawn_big_bertha forever: SHM has no
         historical-sample mechanism for TRANSIENT_LOCAL durability, so
         robot_state_publisher's one-shot durable /robot_description publish
         never reaches the late-joining spawn_big_bertha subscriber over SHM,
         and Cyclone's per-endpoint fallback to normal transport for
         QoS-incompatible pairs doesn't fire here (confirmed open upstream bug,
         ros2/rmw_cyclonedds#401). Fix: keep robot_state_publisher/spawn_robot
         on cyclonedds.xml (SHM off); only the /joint_states writer+reader use
         this file. Cyclone defaults for General/Interfaces (restricting to
         loopback-only + AllowMulticast=false broke discovery for some nodes,
         see cyclonedds.xml). -->
    <SharedMemory>
      <!-- REQUIRES RouDi running first (scripts/roudi.sh, or let
           simulation.launch.py start it automatically via dds_shm:=true).
           Enable=true with no RouDi aborts the process at domain creation
           (iox::errorHandler SIGABRT, confirmed via core dump); it does not
           fall back to normal transport. -->
      <Enable>true</Enable>
      <LogLevel>error</LogLevel>
    </SharedMemory>
  </Domain>
</CycloneDDS>
