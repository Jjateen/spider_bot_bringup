Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Navigation 2
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Reference Frame: map
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacle Markers
      Enabled: true
      Topic:
        Value: /obstacle_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Draw Behind: true
    - Class: rviz_default_plugins/Map
      Name: Global Costmap
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/Map
      Name: Local Costmap
      Enabled: false
      Topic:
        Value: /local_costmap/costmap
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.6
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan_filtered
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 255; 255; 0
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (raw, unfiltered)
      Enabled: false
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Odometry
      Name: Filtered Odometry
      Enabled: true
      Topic:
        Value: /odometry/filtered
      Keep: 100
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Path
      Name: Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Reliability Policy: Reliable
      Color: 0; 255; 0
      Line Style: Lines
    - Class: rviz_default_plugins/Path
      Name: Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Reliability Policy: Reliable
      Color: 0; 12; 255
      Line Style: Lines
    - Class: rviz_default_plugins/Polygon
      Name: Robot Footprint
      Enabled: true
      Topic:
        Value: /local_costmap/published_footprint
        Reliability Policy: Reliable
      Color: 25; 255; 255
    - Class: rviz_default_plugins/Pose
      Name: Goal Pose
      Enabled: true
      Topic:
        Value: /goal_pose
        Reliability Policy: Reliable
      Color: 255; 25; 0
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: nav2_rviz_plugins/GoalTool
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Pitch: 1.0
      Yaw: 0.785
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  Height: 850
  Width: 1300
