Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane Cell Count: 20
      Reference Frame: odom
    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 0.7
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /scan_filtered
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 255; 255; 0
    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan (raw, unfiltered)
      Enabled: false
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
      Color: 255; 0; 0
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: false
      Topic:
        Value: /odom
      Keep: 100
      Covariance:
        Value: false
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      # Camera pinned to the FIXED frame, not base_link. A follow cam keeps the
      # robot centred, so translation is invisible and only the turns read as
      # motion -- the clip looks like the robot is walking on the spot. Pinned
      # here, the robot visibly crosses the view. Focal point sits near the
      # spawn (-3.5, -3.5) with the distance sized to keep the whole run framed.
      Target Frame: <Fixed Frame>
      Distance: 3.0
      Pitch: 0.32
      Yaw: 0.785
      Focal Point:
        X: -3.3
        Y: -3.3
        Z: 0.1
Window Geometry:
  Height: 800
  Width: 1200
