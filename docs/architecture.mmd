%% ========================================================================
%% 1. ENTRY POINTS
%% ========================================================================
subgraph entry_points["🚀 LAUNCH ENTRY POINTS"]:::entry_point_sub
    demo_launch["📦 demo.launch.py<br/>A→B single-goal or 4-leg patrol"]
    demo_straight["📦 demo_straight.launch.py<br/>Gait-only test — no Nav2 / EKF"]
    bringup_launch["📦 bringup.launch.py<br/>Full stack orchestration"]
    rviz_launch["📦 rviz.launch.py<br/>5 RViz view configs"]
end

%% ========================================================================
%% 2. SIMULATION ENVIRONMENT
%% ========================================================================
subgraph simulation["🌍 LAYER 1 — SIMULATION ENVIRONMENT"]:::sim_sub
    gz_server["⚙️  Gazebo Harmonic (gz-sim 8)<br/>dt=0.002s · 500 Hz physics · RTF=1.0"]
    world["🗺️  obstacle_world.sdf<br/>10×10m arena · 4 walls · 3 boxes · 2 pillars"]

    subgraph gz_plugins["Gazebo Plugins — big_bertha.gazebo.xacro"]:::sim_plugin
        odom_pub["OdometryPublisher<br/>/odom @ 50 Hz · odom→base_link tf"]
        vel_ctrl["VelocityControl<br/>Sim-only kinematic drive"]
        gpu_lidar["GPU Lidar<br/>/scan @ 10 Hz · 360° · 8m range"]
        imu_sensor["IMU<br/>/imu @ 100 Hz · gyro+accel noise"]
        gz_ctrl["gz_ros2_control<br/>GazeboSimSystem + ROS2ControlPlugin"]
    end

    rsp["🤖 robot_state_publisher<br/>big_bertha_description"]
    bridge["🔁 ros_gz_bridge parameter_bridge<br/>/clock · /scan · /imu · /odom · /tf"]
    spawn_robot["🐣 Spawn — ros_gz_sim create<br/>robot_description → big_bertha"]

    gz_server --- world
end

%% ========================================================================
%% 3. ROS2_CONTROL
%% ========================================================================
subgraph ros2_control["🎛️  LAYER 2 — ROS2_CONTROL"]:::control_sub
    jsb["joint_state_broadcaster<br/>/joint_states · 12 joints pos+vel"]
    pd_ctrl["JointEffortPdController<br/>kp=20 · kd=2 · effort_limit=1.18 Nm"]
end

%% ========================================================================
%% 4. LOCOMOTION
%% ========================================================================
subgraph locomotion["🦾 LAYER 3 — LOCOMOTION (policy_controller.launch.py)"]:::policy_sub
    policy_node["🧠 policy_controller_node<br/>ONNX Runtime · policy.onnx · 50 Hz"]

    subgraph obs_builder["Observation Builder — 48-d float array"]:::obs_sub
        obs1["[0:3]  root_lin_vel_b  ← /odom"]
        obs2["[3:6]  root_ang_vel_b  ← /imu"]
        obs3["[6:9]  projected_gravity  ← /imu"]
        obs4["[9:12] cmd_vel (vx, vy, wz)  ← /cmd_vel"]
        obs5["[12:24] joint_pos − default  ← /joint_states"]
        obs6["[24:36] joint_vel  ← /joint_states"]
        obs7["[36:48] prev_actions (clamped)"]
    end

    subgraph outer_loops["Outer-loop controllers"]:::outer_sub
        heading_hold["Heading-hold (PI)"]
        lateral_hold["Lateral-hold (P)"]
        diff_steer["Differential-stride steering"]
        gate["Position-hold gate<br/>vx < 0.02 → stance"]
    end
end

%% ========================================================================
%% 5. PERCEPTION + STATE ESTIMATION
%% ========================================================================
subgraph perception_estimation["📡 LAYER 4–5 — PERCEPTION & STATE ESTIMATION"]:::perception_sub
    scan_filter["scan_ground_filter<br/>IMU-gated floor return culler<br/>/scan + /imu → /scan_filtered"]
    ekf["robot_localization EKF<br/>two_d_mode=true<br/>/odom [x,y,yaw] + /imu yaw,wz<br/>→ odom→base_link tf · /odometry/filtered"]
end

%% ========================================================================
%% 6. MAPPING / LOCALIZATION
%% ========================================================================
subgraph mapping_localization["🗺️  LAYER 6 — MAPPING | LOCALIZATION (mutually exclusive)"]:::loc_sub

    subgraph slam_mode["slam=true  —  Live SLAM"]:::loc_sub_inner
        slam_toolbox["slam_toolbox async<br/>/map + map→odom tf<br/>from /scan"]
    end

    subgraph known_map_mode["slam=false  —  Known-map mode"]:::loc_sub_inner
        map_server["nav2_map_server<br/>obstacle_world.yaml"]
        amcl["nav2_amcl<br/>Scan-match localization<br/>→ map→odom tf"]
        ground_truth["map→odom static identity tf<br/>Skips AMCL 4-wall ambiguity"]
    end
end

%% ========================================================================
%% 7. PLANNING + VISUALIZATION
%% ========================================================================
subgraph planning_viz["🧭 LAYER 7–8 — PLANNING & VISUALIZATION"]:::plan_sub

    subgraph nav2_servers["Nav2 Servers — nav2.launch.py"]:::plan_sub_inner
        planner["planner_server<br/>Navfn / Smac"]
        controller_srv["controller_server<br/>Regulated Pure Pursuit"]
        smoother["smoother_server"]
        behaviors["behavior_server<br/>Recovery + spiral"]
        bt_nav["bt_navigator<br/>Custom behavior trees<br/>+ replanning & recovery"]
    end

    life_mgr["lifecycle_manager_navigation<br/>Autostart all Nav2 servers"]

    subgraph viz["Visualization"]:::viz_sub
        rviz_node["RViz2<br/>5 pre-configured views"]
        plotjuggler["PlotJuggler<br/>Layouts: control / sensors"]
    end
end

%% ========================================================================
%% TF TREE
%% ========================================================================
subgraph tf_tree["🔗 TF TREE"]:::tf_sub

    tf_map(["map"])
    tf_odom(["odom"])
    tf_base(["base_link"])

    subgraph legs["12 leg joints (continuous)"]:::tf_sub_inner
        l1["Revolute_110 (leg4 BL)<br/>→ arm_a_4_1 → Revolute_111<br/>→ arm_b_4_1 → Revolute_112<br/>→ arm_c_4_1 ◊ foot"]
        l2["Revolute_113 (leg1 FL)<br/>→ arm_a_1_1 → Revolute_114<br/>→ arm_b_1_1 → Revolute_115<br/>→ arm_c_1_1 ◊ foot"]
        l3["Revolute_116 (leg2 FR)<br/>→ arm_a_2_1 → Revolute_117<br/>→ arm_b_2_1 → Revolute_118<br/>→ arm_c_2_1 ◊ foot"]
        l4["Revolute_119 (leg3 BR)<br/>→ arm_a_3_1 → Revolute_120<br/>→ arm_b_3_1 → Revolute_121<br/>→ arm_c_3_1 ◊ foot"]
    end

    subgraph sensors["Sensor links (fixed)"]:::tf_sub_inner
        lidar_link["lidar_link<br/>YDLidar X2"]
        imu_link["imu_link<br/>MPU9250"]
        battery["battery_link<br/>3S2P pack"]
    end
end

%% ========================================================================
%% EDGES
%% ========================================================================

%% Launch includes
demo_launch -- "includes" --> bringup_launch
demo_straight -- "includes" --> bringup_launch
bringup_launch -- "optionally" --> rviz_launch

%% Bridge → downstream nodes
bridge -- "/clock /scan /imu /odom /tf" --- gz_server
bridge -- "/scan" --- scan_filter
bridge -- "/imu" --- scan_filter
bridge -- "/odom" --- ekf
bridge -- "/imu" --- ekf
bridge -- "/odom" --- policy_node
bridge -- "/imu" --- policy_node

%% Spawn chain
rsp -- "/robot_description" --> spawn_robot
spawn_robot -- "loaded" --> gz_ctrl
gz_ctrl -- "state interfaces" --> jsb
gz_ctrl -- "command interfaces" --> pd_ctrl

%% Joint states
jsb -- "/joint_states (12)" --> policy_node

%% Control loop
policy_node -- "/position_controller/commands [12]" --> pd_ctrl
controller_srv -- "/cmd_vel" --> policy_node

%% Filtered scan
scan_filter -- "/scan_filtered" --> amcl
scan_filter -- "/scan_filtered" --- controller_srv
scan_filter -- "/scan_filtered" --- planner

%% EKF
ekf -- "odom→base_link tf" --- amcl
ekf -- "odom→base_link tf" --- planner
ekf -- "odom→base_link tf" --- controller_srv
ekf -- "/odometry/filtered" --> policy_node

%% Map providers → Planner
slam_toolbox -- "/map + map→odom" --> planner
amcl -- "map→odom" --> planner
map_server -- "/map" --- planner

%% Goal interface
bt_nav -- "/navigate_to_pose" --- demo_launch

%% RViz feeds
rsp -- "full tf tree" --- rviz_node
ekf -- "odom→base_link" --- rviz_node
slam_toolbox -- "/map" --- rviz_node
map_server -- "/map" --- rviz_node

%% TF tree
tf_map -- "SLAM / AMCL / static identity" --> tf_odom
tf_odom -- "EKF (odom_tf=false) or Gazebo (odom_tf=true)" --> tf_base
tf_base -- "robot_state_publisher" --- legs
tf_base -- "robot_state_publisher" --- sensors

