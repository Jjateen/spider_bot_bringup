<?xml version="1.0"?>
<!-- Design ledger: Big Bertha v2, for Isaac Lab and ROS. Units are metres,
     kilograms, seconds, and radians. Full-resolution collision meshes use
     the visual transforms; lower-leg collision proxies are expressed in
     link-frame metres. base_link is the root. Existing frames, joints, and
     inertials are unchanged. Visual materials are pure white. -->
<!-- ROS packaging: mesh URIs resolve through big_bertha_v2_description.
     Geometry, scales, joints, limits, and inertials match the training URDF.
     Consumers: robot_state_publisher and RViz; base_link remains the root. -->
<robot name="Big_Bertha_organized_assembly">

  <!-- Materials -->
  <material name="ABS_solid_baseline_25pct_print_NOT_calibrated">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="MG995_envelope_55g_mass_proxy">
    <color rgba="1 1 1 1"/>
  </material>
  <material name="Steel">
    <color rgba="1 1 1 1"/>
  </material>

